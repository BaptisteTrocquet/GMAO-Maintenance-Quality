{
  "name": "gmao-maintenance-quality",
  "version": "0.1.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run upgrade:check && npm run hardening:check",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/check-db.ts",
    "test:analytics:perf": "tsx scripts/benchmark-analytics.ts",
    "test:e2e": "playwright test",
    "sdk:build": "tsc -p sdk/tsconfig.json",
    "examples:check": "vitest run tests/integration-examples.test.tsx tests/embed-static-example.test.ts tests/widget-loader-example.test.ts tests/erp-connector-example.test.ts tests/iot-connector-example.test.ts",
    "upgrade:check": "tsx scripts/check-upgrade-policy.ts",
    "hardening:check": "tsx scripts/check-production-hardening.ts",
    "deployment:check": "tsx scripts/check-deployment-examples.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run sdk:build && npm run examples:check && npm run upgrade:check && npm run hardening:check && npm run deployment:check && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed",
    "backup:production": "bash scripts/backup-production.sh",
    "restore:production": "bash scripts/restore-production.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.54.2",
    "@types/node": "22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.32.0",
    "eslint-config-next": "15.5.21",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "4.19.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
