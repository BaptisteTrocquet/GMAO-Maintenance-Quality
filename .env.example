DATABASE_URL="postgresql://opengmao:opengmao@localhost:5432/opengmao?schema=public"

# Structured JSON log threshold: debug, info, warn, or error.
# Defaults to debug outside production and info in production.
# LOG_LEVEL="info"

# Production API rate limiting. Enabled by default only when NODE_ENV=production.
# Operational probes (/api/health, /api/ready, /api/metrics) and CORS preflight are exempt.
# RATE_LIMIT_ENABLED="true"
# RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE="30"
# RATE_LIMIT_PUBLIC_PER_MINUTE="120"
# RATE_LIMIT_SERVER_PER_MINUTE="600"
# RATE_LIMIT_DEFAULT_PER_MINUTE="600"
# RATE_LIMIT_MAX_KEYS="10000"
# Do not trust X-Forwarded-For by default. Set this only when the application is behind
# a controlled reverse-proxy chain; use the number of trusted proxy hops between client and app.
# RATE_LIMIT_TRUST_PROXY_HOPS="0"

# Storage provider: local (default) or s3 / s3-compatible.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./data/documents"

# S3-compatible object storage (server-side only; do not expose these values to the browser).
# STORAGE_S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"
# STORAGE_S3_BUCKET="opengmao-files"
# STORAGE_S3_REGION="eu-west-3"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# STORAGE_S3_SESSION_TOKEN=""
# STORAGE_S3_PREFIX="production"
# STORAGE_S3_TIMEOUT_MS="10000"
# STORAGE_S3_MAX_OBJECT_BYTES="26214400"

# Generic OpenID Connect identity provider. This is public provider metadata, not a client secret.
# The configured organization scope is checked before any JWKS network request.
# OIDC_PROVIDER_ID="corporate-oidc"
# OIDC_ORGANIZATION_ID=""
# OIDC_ISSUER="https://identity.example.com/tenant/v2.0"
# OIDC_CLIENT_ID=""
# OIDC_JWKS_URI="https://identity.example.com/tenant/discovery/v2.0/keys"
# OIDC_EMAIL_CLAIM="email"
# OIDC_DISPLAY_NAME_CLAIMS="name,preferred_username"
# OIDC_REQUIRE_EMAIL_VERIFIED="false"

# Connector credential vault encryption keys (server-side only).
# Generate each value from 32 random bytes encoded as standard base64.
# CONNECTOR_CREDENTIAL_KEY_VERSION="v1"
# CONNECTOR_CREDENTIAL_MASTER_KEY_BASE64=""
# During key rotation, keep one previous key available for decryption until credentials are re-saved.
# CONNECTOR_CREDENTIAL_PREVIOUS_KEY_VERSION=""
# CONNECTOR_CREDENTIAL_PREVIOUS_MASTER_KEY_BASE64=""

# Optional OpenAI AI adapters (server-side only).
# OPENAI_API_KEY is shared by the adapters below but does not enable either feature by itself.
# Each model variable is the activation switch for its own adapter.
# OPENAI_API_KEY=""
# OPENAI_LLM_MODEL=""
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Optional output dimension override for embedding models that support it.
# OPENAI_EMBEDDING_DIMENSIONS=""
