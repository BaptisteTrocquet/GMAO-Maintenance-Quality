generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MAINTENANCE_MANAGER
  TECHNICIAN
  QUALITY_MANAGER
  OPERATOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  IMPROVEMENT
  SAFETY
  OTHER
}

enum WorkOrderStatus {
  REQUESTED
  APPROVED
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  OBSOLETE
  REJECTED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceFrequencyUnit {
  DAY
  WEEK
  MONTH
  YEAR
  METER
}

enum PublicRequestMode {
  PUBLIC
  EMBEDDED
}

enum MaintenanceReminderStatus {
  ACTIVE
  DISMISSED
  EXPIRED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  WORK_ORDER_CONSUMPTION
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  displayName         String
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         OrganizationMembership[]
  sessions            Session[]
  invitationsCreated  OrganizationInvitation[] @relation("InvitationCreator")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationAcceptor")
  assignedWorkOrders  WorkOrder[]              @relation("AssignedWorkOrders")
  requestedWorkOrders WorkOrder[]              @relation("RequestedWorkOrders")
  maintenanceTeams    MaintenanceTeamMember[]
  documentApprovals   DocumentApproval[]
  auditLogs           AuditLog[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  name        String
  timezone    String                   @default("UTC")
  locale      String                   @default("en")
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  sites       Site[]
  parts       Part[]
  suppliers   Supplier[]
  documents   Document[]
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(VIEWER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  allSites       Boolean          @default(false)
  expiresAt      DateTime
  createdById    String
  acceptedById   String?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([organizationId, email, status])
  @@index([expiresAt, status])
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  role            MembershipRole   @default(VIEWER)
  allSites        Boolean          @default(false)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteMemberships SiteMembership[]

  @@unique([organizationId, userId])
  @@index([userId, active])
}

model SiteMembership {
  id                       String                 @id @default(cuid())
  organizationMembershipId String
  siteId                   String
  createdAt                DateTime               @default(now())
  organizationMembership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  site                     Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationMembershipId, siteId])
  @@index([siteId])
}

model Site {
  id                   String                @id @default(cuid())
  organizationId       String
  name                 String
  code                 String
  description          String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships          SiteMembership[]
  maintenanceTeams     MaintenanceTeam[]
  maintenanceReminders MaintenanceReminder[]
  locations            Location[]
  assets               Asset[]
  workOrders           WorkOrder[]
  warehouses           Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model MaintenanceTeam {
  id          String                  @id @default(cuid())
  siteId      String
  code        String
  name        String
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  site        Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  members     MaintenanceTeamMember[]
  workOrders  WorkOrder[]

  @@unique([siteId, code])
  @@index([siteId, active])
}

model MaintenanceTeamMember {
  teamId    String
  userId    String
  createdAt DateTime        @default(now())
  team      MaintenanceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Location {
  id          String     @id @default(cuid())
  siteId      String
  parentId    String?
  name        String
  code        String
  description String?
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  assets      Asset[]

  @@unique([siteId, code])
}

model Asset {
  id               String      @id @default(cuid())
  siteId           String
  locationId       String?
  parentAssetId    String?
  code             String
  name             String
  description      String?
  category         String?
  manufacturer     String?
  model             String?
  serialNumber     String?
  status           AssetStatus @default(ACTIVE)
  criticality      Criticality @default(MEDIUM)
  installedAt      DateTime?
  commissionedAt   DateTime?
  decommissionedAt DateTime?
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  site             Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  location         Location?   @relation(fields: [locationId], references: [id])
  parentAsset      Asset?      @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets      Asset[]     @relation("AssetHierarchy")
  workOrders       WorkOrder[]
  maintenancePlans MaintenancePlan[]
  assetDocuments   AssetDocument[]
  attachments      AssetAttachment[]
  meters           Meter[]
  statusHistory    AssetStatusHistory[]
  assetParts       AssetPart[]

  @@unique([siteId, code])
  @@index([siteId, archivedAt])
}

model AssetStatusHistory {
  id          String       @id @default(cuid())
  assetId     String
  fromStatus  AssetStatus?
  toStatus    AssetStatus
  note        String?
  changedById String?
  changedAt   DateTime     @default(now())
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, changedAt])
}

model AssetAttachment {
  id         String   @id @default(cuid())
  assetId    String
  fileName   String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  kind       String   @default("ATTACHMENT")
  createdBy  String?
  createdAt  DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

model WorkOrder {
  id               String                     @id @default(cuid())
  number           String                     @unique
  siteId           String
  assetId          String?
  requesterId      String?
  assigneeId       String?
  teamId           String?
  title            String
  description      String?
  type             WorkOrderType
  status           WorkOrderStatus            @default(REQUESTED)
  priority         Priority                   @default(NORMAL)
  requestedAt      DateTime                   @default(now())
  plannedStart     DateTime?
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  downtimeMinutes  Int?
  laborMinutes     Int?
  completionNote   String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  site             Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  asset            Asset?                     @relation(fields: [assetId], references: [id])
  requester        User?                      @relation("RequestedWorkOrders", fields: [requesterId], references: [id])
  assignee         User?                      @relation("AssignedWorkOrders", fields: [assigneeId], references: [id])
  team             MaintenanceTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parts            WorkOrderPart[]
  partConsumptions WorkOrderPartConsumption[]
  checkItems       WorkOrderCheckItem[]
  documents        WorkOrderDocument[]
  attachments      WorkOrderAttachment[]
  reminders        MaintenanceReminder[]

  @@index([siteId, status, requestedAt])
  @@index([teamId])
}

model WorkOrderCheckItem {
  id          String    @id @default(cuid())
  workOrderId String
  label       String
  completed   Boolean   @default(false)
  note        String?
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model WorkOrderAttachment {
  id          String    @id @default(cuid())
  workOrderId String
  fileName    String
  storageKey String
  mimeType    String?
  sizeBytes   Int?
  kind        String    @default("ATTACHMENT")
  createdBy   String?
  createdAt   DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
}

model MaintenanceReminder {
  id            String                    @id @default(cuid())
  siteId        String
  workOrderId   String
  occurrenceKey String                    @unique
  title         String
  assetCode     String?
  dueAt         DateTime
  remindAt      DateTime
  leadDays      Int
  status        MaintenanceReminderStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  dismissedAt   DateTime?
  site          Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder                 @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([siteId, status, dueAt])
  @@index([workOrderId, status])
}

model MaintenancePlan {
  id                String                     @id @default(cuid())
  assetId           String
  meterId           String?
  name              String
  description       String?
  frequencyValue    Int
  frequencyUnit     MaintenanceFrequencyUnit
  nextDueAt         DateTime?
  nextDueMeterValue Float?
  active            Boolean                    @default(true)
  estimatedMinutes  Int?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  asset             Asset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  meter             Meter?                     @relation(fields: [meterId], references: [id], onDelete: SetNull)
  checklistItems    MaintenancePlanCheckItem[]

  @@index([meterId, active])
}

model MaintenancePlanCheckItem {
  id                String          @id @default(cuid())
  maintenancePlanId String
  sequence          Int
  label             String
  mandatory         Boolean         @default(true)
  maintenancePlan   MaintenancePlan @relation(fields: [maintenancePlanId], references: [id], onDelete: Cascade)
}

model Part {
  id                    String                     @id @default(cuid())
  organizationId        String
  sku                   String
  name                  String
  description           String?
  unit                  String                     @default("EA")
  quantityOnHand        Float                      @default(0)
  reorderPoint          Float                      @default(0)
  unitCost              Decimal?                   @db.Decimal(14, 4)
  active                Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetParts            AssetPart[]
  workOrderParts        WorkOrderPart[]
  workOrderConsumptions WorkOrderPartConsumption[]
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  supplierReferences    PartSupplier[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  name           String
  contactName    String?
  email          String?
  phone           String?
  website        String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partReferences PartSupplier[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PartSupplier {
  partId             String
  supplierId         String
  supplierPartNumber String
  preferred          Boolean   @default(false)
  leadTimeDays       Int?
  minOrderQuantity   Float?
  unitCost           Decimal?  @db.Decimal(14, 4)
  currency           String    @default("EUR")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  part               Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier           Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([partId, supplierId])
  @@index([supplierId, active])
  @@index([partId, preferred, active])
}

model Warehouse {
  id          String     @id @default(cuid())
  siteId      String
  code        String
  name        String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  bins        StockBin[]

  @@unique([siteId, code])
  @@index([siteId, active])
}

model StockBin {
  id                    String                     @id @default(cuid())
  warehouseId           String
  code                  String
  name                  String
  description           String?
  active                Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  warehouse             Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  balances              StockBalance[]
  movements             StockMovement[]
  workOrderConsumptions WorkOrderPartConsumption[]

  @@unique([warehouseId, code])
  @@index([warehouseId, active])
}

model StockBalance {
  id        String   @id @default(cuid())
  binId     String
  partId    String
  quantity  Float    @default(0)
  updatedAt DateTime @updatedAt
  bin       StockBin @relation(fields: [binId], references: [id], onDelete: Cascade)
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([binId, partId])
  @@index([partId])
}

model StockMovement {
  id                String            @id @default(cuid())
  binId             String
  partId            String
  type              StockMovementType
  delta             Float
  balanceAfter      Float
  partQuantityAfter Float
  unitCost          Decimal?          @db.Decimal(14, 4)
  referenceType     String?
  referenceId       String?
  idempotencyKey    String
  requestHash       String
  actorId           String?
  note              String?
  createdAt         DateTime          @default(now())
  bin               StockBin          @relation(fields: [binId], references: [id], onDelete: Restrict)
  part              Part              @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([binId, idempotencyKey])
  @@index([binId, createdAt])
  @@index([partId, createdAt])
  @@index([referenceType, referenceId])
}

model AssetPart {
  assetId             String
  partId              String
  quantityRecommended Float?
  asset               Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  part                Part  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([assetId, partId])
}

model WorkOrderPart {
  workOrderId String
  partId      String
  quantity    Float
  unitCost    Decimal?  @db.Decimal(14, 4)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part        Part      @relation(fields: [partId], references: [id])

  @@id([workOrderId, partId])
}

model WorkOrderPartConsumption {
  id             String    @id @default(cuid())
  workOrderId    String
  partId         String
  binId          String?
  quantity       Float
  unitCost       Decimal?  @db.Decimal(14, 4)
  idempotencyKey String
  actorId        String?
  createdAt      DateTime  @default(now())
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part           Part      @relation(fields: [partId], references: [id])
  bin            StockBin? @relation(fields: [binId], references: [id])

  @@unique([workOrderId, idempotencyKey])
  @@index([workOrderId, createdAt])
  @@index([partId, createdAt])
  @@index([binId, createdAt])
}

model Document {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  title          String
  type           String
  owner          String?
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revisions      DocumentRevision[]
  assetDocuments AssetDocument[]
  workOrders     WorkOrderDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model DocumentRevision {
  id            String             @id @default(cuid())
  documentId    String
  revision      String
  status        DocumentStatus     @default(DRAFT)
  effectiveAt   DateTime?
  expiresAt     DateTime?
  storageKey    String?
  fileName      String?
  mimeType      String?
  checksum      String?
  changeSummary String?
  createdBy     String?
  createdAt     DateTime           @default(now())
  document      Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvals     DocumentApproval[]

  @@unique([documentId, revision])
}

model DocumentApproval {
  id                 String            @id @default(cuid())
  documentRevisionId String
  approverId         String
  decision           ApprovalDecision @default(PENDING)
  comment            String?
  decidedAt          DateTime?
  revision           DocumentRevision @relation(fields: [documentRevisionId], references: [id], onDelete: Cascade)
  approver           User              @relation(fields: [approverId], references: [id])

  @@unique([documentRevisionId, approverId])
}

model AssetDocument {
  assetId    String
  documentId String
  relation   String   @default("APPLICABLE")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([assetId, documentId])
}

model WorkOrderDocument {
  workOrderId String
  documentId  String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([workOrderId, documentId])
}

model Meter {
  id               String            @id @default(cuid())
  assetId          String
  code             String
  name             String
  unit             String
  allowRollover    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings         MeterReading[]
  maintenancePlans MaintenancePlan[]

  @@unique([assetId, code])
}

model MeterReading {
  id        String   @id @default(cuid())
  meterId   String
  value     Float
  note      String?
  readingAt DateTime @default(now())
  meter     Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([meterId, readingAt])
}

model PublicMaintenanceRequestToken {
  id             String                               @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  tokenHash      String                               @unique
  mode           PublicRequestMode                    @default(PUBLIC)
  allowedOrigins String[]                             @default([])
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime                             @default(now())
  lastUsedAt     DateTime?
  submissions    PublicMaintenanceRequestSubmission[]

  @@index([organizationId, siteId, revokedAt])
  @@index([expiresAt])
}

model PublicMaintenanceRequestSubmission {
  id               String                        @id @default(cuid())
  tokenId          String
  workOrderId      String
  idempotencyKey   String
  requesterName    String?
  requesterEmail   String?
  requesterRef     String?
  origin           String?
  createdAt        DateTime                      @default(now())
  token            PublicMaintenanceRequestToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, idempotencyKey])
  @@index([tokenId, createdAt])
  @@index([workOrderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model IntegrationDeadLetter {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  channel        String
  sourceId       String
  reason         String
  attempts       Int
  statusCode     Int?
  errorCode      String?
  payloadJson    String
  replayCount    Int      @default(0)
  lastReplayedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, channel, sourceId])
  @@index([organizationId, siteId, resolvedAt, createdAt])
}
